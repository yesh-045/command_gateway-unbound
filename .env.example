PROJECT_NAME=cli gateway
PROJECT_VERSION=0.1.0
ENVIRONMENT=local
DEBUG=true
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=sqlite+aiosqlite:///./gateway.db

# Defaults
DEFAULT_CREDITS=100
DEFAULT_COMMAND_COST=1
DEFAULT_RULE_ACTION=AUTO_REJECT
DEFAULT_APPROVAL_THRESHOLD=1
RATE_LIMIT_PER_MINUTE=60

# Seeding
SEED_ADMIN_ENABLED=true
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_CREDITS=100
SEED_STARTER_RULES=true

# CLI auth and target
GATEWAY_API_KEY=put-your-admin-api-key-here
GATEWAY_BASE_URL=http://localhost:8000

# Notifications 
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_FROM=
EMAIL_TO=
EMAIL_USERNAME=
EMAIL_PASSWORD=
